---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---
<section {...storyblokEditable(blok)} style="padding: 4rem 2rem; background: #f9f9f9;">
  <h2 style="font-size: 2.5rem; color: #333;">{blok.title}</h2>
  <p style="font-size: 1.1rem; line-height: 1.8; color: #666;">{blok.text}</p>
</section>